<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Dog bills: no item product. Each finished bill makes a dog of the extension's kind and docks it in the stable;
       "Do until you have X" counts the stable's dogs of that kind. -->
  <RecipeDef Name="QR_AssembleDogBase" Abstract="True">
    <workerClass>Quadrunner.RecipeWorker_AssembleDog</workerClass>
    <workerCounterClass>Quadrunner.RecipeWorkerCounter_Dogs</workerCounterClass>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <targetCountAdjustment>1</targetCountAdjustment>
    <researchPrerequisite>MicroelectronicsBasics</researchPrerequisite>
  </RecipeDef>

  <RecipeDef ParentName="QR_AssembleDogBase">
    <defName>QR_AssembleQuadrunner</defName>
    <label>assemble Quadrunner</label>
    <description>Assemble a Quadrunner. It docks straight into this stable.</description>
    <jobString>Assembling Quadrunner.</jobString>
    <workAmount>3000</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>80</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>30</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Plasteel</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="Quadrunner.AssembleProps">
        <kind>QR_Quadrunner</kind>
      </li>
    </modExtensions>
  </RecipeDef>

  <RecipeDef ParentName="QR_AssembleDogBase">
    <defName>QR_AssembleMedirunner</defName>
    <label>assemble Medirunner</label>
    <description>Assemble a Medirunner, a rescue robot. It docks straight into this stable.</description>
    <jobString>Assembling Medirunner.</jobString>
    <workAmount>3500</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>80</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>50</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Plasteel</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="Quadrunner.AssembleProps">
        <kind>QR_Medirunner</kind>
      </li>
    </modExtensions>
  </RecipeDef>

  <!-- A destroyed dog leaves its corpse as the wreck; rebuilding it costs about half the recipe and brings the same dog
       back (agent default, 2026-10-20: half the steel and plasteel, no component). -->
  <RecipeDef ParentName="QR_AssembleDogBase">
    <defName>QR_RebuildQuadrunner</defName>
    <label>rebuild Quadrunner</label>
    <description>Rebuild a destroyed Quadrunner from its wreck. The same dog docks straight into this stable.</description>
    <jobString>Rebuilding Quadrunner.</jobString>
    <workerClass>Quadrunner.RecipeWorker_RebuildDog</workerClass>
    <workAmount>1500</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Corpse_QR_Quadrunner</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>40</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>15</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Corpse_QR_Quadrunner</li>
        <li>Steel</li>
        <li>Plasteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="Quadrunner.AssembleProps">
        <kind>QR_Quadrunner</kind>
      </li>
    </modExtensions>
  </RecipeDef>

  <RecipeDef ParentName="QR_AssembleDogBase">
    <defName>QR_RebuildMedirunner</defName>
    <label>rebuild Medirunner</label>
    <description>Rebuild a destroyed Medirunner from its wreck. The same dog docks straight into this stable.</description>
    <jobString>Rebuilding Medirunner.</jobString>
    <workerClass>Quadrunner.RecipeWorker_RebuildDog</workerClass>
    <workAmount>1750</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Corpse_QR_Medirunner</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>40</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>25</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Corpse_QR_Medirunner</li>
        <li>Steel</li>
        <li>Plasteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="Quadrunner.AssembleProps">
        <kind>QR_Medirunner</kind>
      </li>
    </modExtensions>
  </RecipeDef>

  <RecipeDef ParentName="QR_AssembleDogBase">
    <defName>QR_AssembleCombatdog</defName>
    <label>assemble Combatdog</label>
    <description>Assemble a Tier 1 Combatdog, a clawed guard robot. It docks straight into this stable.</description>
    <jobString>Assembling Combatdog.</jobString>
    <workAmount>4000</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>100</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>50</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Plasteel</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="Quadrunner.AssembleProps">
        <kind>QR_Combatdog</kind>
      </li>
    </modExtensions>
  </RecipeDef>

  <RecipeDef ParentName="QR_AssembleDogBase">
    <defName>QR_RebuildCombatdog</defName>
    <label>rebuild Combatdog</label>
    <description>Rebuild a destroyed Combatdog from its wreck. The same dog docks straight into this stable.</description>
    <jobString>Rebuilding Combatdog.</jobString>
    <workerClass>Quadrunner.RecipeWorker_RebuildDog</workerClass>
    <workAmount>2000</workAmount>
    <ingredients>
      <!-- Any tier's wreck, for the same price: it comes back at its tier (agent default, 2026-10-20). -->
      <li>
        <filter>
          <thingDefs>
            <li>Corpse_QR_Combatdog</li>
            <li>Corpse_QR_CombatdogTwo</li>
            <li>Corpse_QR_CombatdogThree</li>
            <li>Corpse_QR_CombatdogFour</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>50</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>25</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Corpse_QR_Combatdog</li>
        <li>Corpse_QR_CombatdogTwo</li>
        <li>Corpse_QR_CombatdogThree</li>
        <li>Corpse_QR_CombatdogFour</li>
        <li>Steel</li>
        <li>Plasteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="Quadrunner.AssembleProps">
        <kind>QR_Combatdog</kind>
      </li>
    </modExtensions>
  </RecipeDef>

  <!-- Combatdog upgrades: ordered per dog from the stable's Overview tab, which adds the bill (user, 2026-10-20); not in
       the stable's Bills list. Done while the dog is docked; the dog comes back as the next tier with its name. Costs from
       the design's table; work amounts agent default (2026-10-20). -->
  <RecipeDef Name="QR_UpgradeCombatdogBase" Abstract="True">
    <workerClass>Quadrunner.RecipeWorker_UpgradeDog</workerClass>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <researchPrerequisite>MicroelectronicsBasics</researchPrerequisite>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Plasteel</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

  <RecipeDef ParentName="QR_UpgradeCombatdogBase">
    <defName>QR_UpgradeCombatdogTwo</defName>
    <label>upgrade Combatdog to Tier 2</label>
    <description>Rebuild a docked Combatdog as Tier 2: a built-in gun and much more durability. It keeps its name.</description>
    <jobString>Upgrading Combatdog.</jobString>
    <workAmount>3000</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>100</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>75</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>2</count></li>
    </ingredients>
  </RecipeDef>

  <RecipeDef ParentName="QR_UpgradeCombatdogBase">
    <defName>QR_UpgradeCombatdogThree</defName>
    <label>upgrade Combatdog to Tier 3</label>
    <description>Rebuild a docked Combatdog as Tier 3: a second weapon slot with a flamethrower and much more armor. It keeps its name.</description>
    <jobString>Upgrading Combatdog.</jobString>
    <workAmount>4000</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>150</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>100</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>3</count></li>
    </ingredients>
  </RecipeDef>

  <RecipeDef ParentName="QR_UpgradeCombatdogBase">
    <defName>QR_UpgradeCombatdogFour</defName>
    <label>upgrade Combatdog to Tier 4</label>
    <description>Rebuild a docked Combatdog as Tier 4: a built-in minigun and extreme armor. It keeps its name.</description>
    <jobString>Upgrading Combatdog.</jobString>
    <workAmount>5000</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>200</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>150</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>4</count></li>
    </ingredients>
  </RecipeDef>

  <RecipeDef Name="QR_MakeFieldFixBase" Abstract="True">
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <researchPrerequisite>MicroelectronicsBasics</researchPrerequisite>
  </RecipeDef>

  <RecipeDef ParentName="QR_MakeFieldFixBase">
    <defName>QR_MakeRobodogBattery</defName>
    <label>make robodog battery</label>
    <description>Make a robodog battery. Colonists carry it to a powered-down robodog in the field and charge it to full on the spot.</description>
    <jobString>Making robodog battery.</jobString>
    <workAmount>800</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <QR_RobodogBattery>1</QR_RobodogBattery>
    </products>
  </RecipeDef>

  <RecipeDef ParentName="QR_MakeFieldFixBase">
    <defName>QR_MakeRobodogRepairKit</defName>
    <label>make robodog repair kit</label>
    <description>Make a robodog repair kit. Colonists carry it to a damaged robodog in the field and repair it on the spot.</description>
    <jobString>Making robodog repair kit.</jobString>
    <workAmount>800</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>30</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>10</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Plasteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <QR_RobodogRepairKit>1</QR_RobodogRepairKit>
    </products>
  </RecipeDef>

</Defs>
