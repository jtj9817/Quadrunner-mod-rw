<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Modeled on vanilla "Smoke" (harmsHealth=false, defaultDamage=0): uses Smokepop Pack's BlastExtinguisher burst and
       Smoke wisps tinted from musk green (center) to light yellow (edge). Can't injure, can't kill. -->
  <DamageDef>
    <defName>QR_TearGasDamage</defName>
    <label>tear gas</label>
    <workerClass>Quadrunner.DamageWorker_TearGas</workerClass>
    <canInterruptJobs>false</canInterruptJobs>
    <makesBlood>false</makesBlood>
    <defaultDamage>0</defaultDamage>
    <explosionCellFleck>BlastExtinguisher</explosionCellFleck>
    <explosionColorCenter>(0.32, 0.54, 0.28, 0.95)</explosionColorCenter>
    <explosionColorEdge>(0.98, 0.95, 0.58, 0.05)</explosionColorEdge>
    <soundExplosion>Explosion_Stun</soundExplosion>
    <harmsHealth>false</harmsHealth>
    <combatLogRules>Damage_Extinguish</combatLogRules>
  </DamageDef>
</Defs>
