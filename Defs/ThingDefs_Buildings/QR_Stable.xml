<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Fifteen shared docks, a service gantry and the bills for every robodog. -->
  <ThingDef ParentName="BuildingBase">
    <defName>QR_Stable</defName>
    <label>Quadrunner stable</label>
    <description>Hearthline Robotics — "A good dog for a bad world."\n\nBuilt for settlements beyond dependable supply routes, Hearthline's machines use locally fabricated parts and a common quadruped chassis. Utility and rescue models made its reputation; armed "settlement assurance" models made its margins. The later brochures show noticeably fewer settlers.\n\nA fabrication, dispatch and service hub for up to 15 Quadrunners, Medirunners and Combatdogs in shared docking slots. Add bills to assemble dogs, batteries and repair kits; use Overview to manage dogs and Combatdog upgrades. Docked dogs recharge and repair while the stable has power.</description>
    <thingClass>Quadrunner.Building_Stable</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Quadrunner/Buildings/Stable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0,0,3,1.8)</rect>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
      <shadowData>
        <volume>(3,0.5,2)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <size>(3,2)</size>
    <defaultPlacingRot>South</defaultPlacingRot>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,2)</interactionCellOffset>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>60</Mass>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <inspectorTabs>
      <li>Quadrunner.ITab_StableOverview</li>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <recipes>
      <li>QR_AssembleQuadrunner</li>
      <li>QR_RebuildQuadrunner</li>
      <li>QR_AssembleMedirunner</li>
      <li>QR_RebuildMedirunner</li>
      <li>QR_AssembleCombatdog</li>
      <li>QR_RebuildCombatdog</li>
      <li>QR_MakeRobodogBattery</li>
      <li>QR_MakeRobodogRepairKit</li>
    </recipes>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <modExtensions>
      <li Class="Quadrunner.StableProps">
        <capacity>15</capacity>
        <serviceRadius>40</serviceRadius>
        <dispatchInterval>250</dispatchInterval>
        <idleBackoff>1000</idleBackoff>
        <repairPerTick>0.02</repairPerTick>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
