<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef ParentName="DiseaseBase">
    <!-- Copied from Vanilla Weapons Expanded - Non-Lethal (VWE_TearGas, user, 2026-11-13): "tear gas causing burning
         sensation in the eyes and nose, totally disabling the sight ability of the victim." Applied by QR_TearGasCloud,
         not by weapons directly. Decays -30/day, so a full severity fades in about 48 minutes. -->
    <defName>QR_TearGas</defName>
    <label>tear gas</label>
    <description>Tear gas causing a burning sensation in the eyes and nose, totally disabling the sight ability of the victim.</description>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-30</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>wearing off</label>
        <painFactor>1.0</painFactor>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>teary</label>
        <painFactor>1.2</painFactor>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.8</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>blinded</label>
        <painFactor>2</painFactor>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-1</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.6</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.6</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Battery at 0%: the dog can't move (so it's downed) until it gets power again. A condition, not damage. -->
  <HediffDef>
    <defName>QR_PoweredDown</defName>
    <label>powered down</label>
    <description>The battery is empty. The robodog can't move until it is recharged at its stable or given a robodog battery.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.8, 0.3)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
