<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Combatdog built-in guns: part of the dog, like vanilla mechanoid guns (destroyed when dropped, never traded, never
       on a raider), picked per slot from the stable's Overview tab (user, 2026-10-20). Stats copy the vanilla gun named
       in each label. -->
  <ThingDef Name="QR_BuiltInGunBase" ParentName="BaseGun" Abstract="True">
    <destroyOnDrop>true</destroyOnDrop>
    <tradeability>None</tradeability>
    <generateCommonality>0</generateCommonality>
    <relicChance>0</relicChance>
    <smeltable>false</smeltable>
    <techLevel>Spacer</techLevel>
    <soundInteract>Interact_Rifle</soundInteract>
    <graphicData>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <comps>
      <li>
        <compClass>Quadrunner.CompBuiltInGun</compClass>
      </li>
    </comps>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="QR_BuiltInGunBase">
    <defName>QR_Gun_AssaultRifle</defName>
    <label>built-in assault rifle</label>
    <description>Hearthline's standard "settlement assurance" rifle mount. A familiar mechanism in a weatherproof housing, advertised as a reassuring presence along any property boundary. Reassurance is delivered in three-round bursts.\n\nA Combatdog's built-in assault rifle: balanced accuracy, good range and controlled bursts. Available in the primary gun slot of Tiers 2, 3 and 4; select it in the stable's Overview.</description>
    <graphicData>
      <texPath>Quadrunner/Weapons/AssaultRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>500</MarketValue>
      <Mass>3.5</Mass>
      <AccuracyTouch>0.60</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.70</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_AssaultRifle</defaultProjectile>
        <warmupTime>1.0</warmupTime>
        <range>30.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>Shot_AssaultRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="QR_BuiltInGunBase">
    <defName>QR_Gun_LMG</defName>
    <label>built-in LMG</label>
    <description>A belt-fed Hearthline security mount for customers who considered the standard rifle's pauses an unnecessary courtesy. The brochure recommends it for "distributed access-denial requirements," beside a photograph of a very empty road.\n\nA Combatdog's built-in light machine gun. Its longer bursts trade accuracy and range for more shots, making it useful against groups. Available in the primary gun slot of Tiers 2, 3 and 4; select it in the stable's Overview.</description>
    <graphicData>
      <texPath>Quadrunner/Weapons/LMG</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>500</MarketValue>
      <Mass>8.5</Mass>
      <AccuracyTouch>0.40</AccuracyTouch>
      <AccuracyShort>0.48</AccuracyShort>
      <AccuracyMedium>0.35</AccuracyMedium>
      <AccuracyLong>0.26</AccuracyLong>
      <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_LMG</defaultProjectile>
        <warmupTime>1.8</warmupTime>
        <range>25.9</range>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <burstShotCount>6</burstShotCount>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <!-- Tier 4: the vanilla minigun's stats, its move-speed penalty included (design). -->
  <ThingDef ParentName="QR_BuiltInGunBase">
    <defName>QR_Gun_Minigun</defName>
    <label>built-in minigun</label>
    <description>Hearthline's premium answer to a question its sales department preferred not to record. The rotating barrel assembly required a reinforced mount, revised balance software and a much less friendly product photograph.\n\nA Tier 4 Combatdog's built-in minigun. Slow to spin up and inaccurate, but fires very long bursts at high speed. Its weight slightly reduces the dog's movement speed. Shares the tier's single gun slot with the assault rifle and LMG.</description>
    <graphicData>
      <texPath>Quadrunner/Weapons/Minigun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1200</MarketValue>
      <Mass>10</Mass>
      <AccuracyTouch>0.2</AccuracyTouch>
      <AccuracyShort>0.25</AccuracyShort>
      <AccuracyMedium>0.25</AccuracyMedium>
      <AccuracyLong>0.18</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <equippedStatOffsets>
      <MoveSpeed>-0.25</MoveSpeed>
    </equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Minigun</defaultProjectile>
        <warmupTime>2.5</warmupTime>
        <range>30.9</range>
        <burstShotCount>25</burstShotCount>
        <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <!-- Tier 3's second slot. Core has no flamethrower (design), and the Core assembly's spray verbs spawn DLC defs, so it
       is a short-range gun firing burning blobs: Flame damage sets what it hits alight. -->
  <ThingDef ParentName="QR_BuiltInGunBase">
    <defName>QR_Gun_Flamethrower</defName>
    <label>built-in flamethrower</label>
    <description>Originally catalogued by Hearthline as a vegetation-management attachment. Its reassignment to the security division changed the paint scheme, the warranty terms and very little else.\n\nA Tier 3 Combatdog's secondary weapon. Fires short-range bursts of burning fuel that can set targets alight; the dog switches to it automatically at close range. Fire can spread beyond the target, so keep it away from anything you want to preserve.</description>
    <graphicData>
      <texPath>Quadrunner/Weapons/Flamethrower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>600</MarketValue>
      <Mass>6</Mass>
      <AccuracyTouch>0.9</AccuracyTouch>
      <AccuracyShort>0.8</AccuracyShort>
      <AccuracyMedium>0.6</AccuracyMedium>
      <AccuracyLong>0.4</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>QR_Bullet_Flame</defaultProjectile>
        <warmupTime>0.8</warmupTime>
        <range>8.9</range>
        <burstShotCount>5</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>InfernoCannon_Fire</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>QR_Bullet_Flame</defName>
    <label>burning fuel</label>
    <description>Burning fuel discharged by a Hearthline flamethrower. The service manual's advice is unusually direct: do not stand in front of the nozzle.\n\nAn incendiary projectile that deals flame damage and can ignite what it hits. It is not a stockpiled fuel item.</description>
    <graphicData>
      <texPath>Things/Projectile/LauncherShot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <color>(254,140,40)</color>
    </graphicData>
    <projectile>
      <damageDef>Flame</damageDef>
      <damageAmountBase>9</damageAmountBase>
      <speed>30</speed>
      <ai_IsIncendiary>true</ai_IsIncendiary>
    </projectile>
  </ThingDef>

</Defs>
