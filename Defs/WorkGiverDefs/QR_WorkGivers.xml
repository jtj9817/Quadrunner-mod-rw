<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Colonists do stable bills under Crafting (agent default, 2026-10-19). -->
  <WorkGiverDef>
    <defName>QR_DoBillsStable</defName>
    <label>assemble robodogs</label>
    <giverClass>Quadrunner.WorkGiver_DoBillsStable</giverClass>
    <workType>Crafting</workType>
    <priorityInType>50</priorityInType>
    <fixedBillGiverDefs>
      <li>QR_Stable</li>
    </fixedBillGiverDefs>
    <verb>assemble robodogs at</verb>
    <gerund>assembling robodogs at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- Colonists bring a robodog battery or repair kit to a dog in the field, under Hauling, before general hauling
       (agent default, 2026-10-20). -->
  <WorkGiverDef>
    <defName>QR_FieldFixRobodog</defName>
    <label>bring robodog batteries and repair kits</label>
    <giverClass>Quadrunner.WorkGiver_FieldFixRobodog</giverClass>
    <workType>Hauling</workType>
    <priorityInType>110</priorityInType>
    <verb>bring a field fix to</verb>
    <gerund>bringing a field fix to</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
