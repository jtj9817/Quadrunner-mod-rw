<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Every robodog: a player-built machine. Intelligence Animal on a non-organic flesh type, so vanilla sees neither an
       animal nor a mechanoid: no taming, training, slaughter, hunting, wild spawns or manhunter packs, no food or rest. -->
  <ThingDef ParentName="BasePawn" Name="QR_RobodogBase" Abstract="True">
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <tradeability>None</tradeability>
    <statBases>
      <MarketValue>600</MarketValue>
      <Mass>40</Mass>
      <MoveSpeed>4.8</MoveSpeed>
      <Flammability>0</Flammability>
      <PsychicSensitivity>0</PsychicSensitivity>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>250</ComfyTemperatureMax>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>0</Wildness>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <ArmorRating_Heat>1</ArmorRating_Heat>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <race>
      <intelligence>Animal</intelligence>
      <fleshType>QR_Robotic</fleshType>
      <body>QR_Robodog</body>
      <thinkTreeMain>QR_Robodog</thinkTreeMain>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <foodType>None</foodType>
      <trainability>None</trainability>
      <petness>0</petness>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <canBePredatorPrey>false</canBePredatorPrey>
      <herdAnimal>false</herdAnimal>
      <lifeExpectancy>2500</lifeExpectancy>
      <!-- Puts out a fire next to a powered-down dog before carrying it home. -->
      <giveNonToolUserBeatFireVerb>true</giveNonToolUserBeatFireVerb>
      <bloodDef>Filth_MachineBits</bloodDef>
      <nameGenerator>NamerAnimalGenericMale</nameGenerator>
      <baseBodySize>0.8</baseBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidBash_Miss</soundMeleeMiss>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
    <inspectorTabs Inherit="False">
      <li>ITab_Pawn_Health</li>
      <li>ITab_Pawn_Needs</li>
      <li>ITab_Pawn_Gear</li>
      <li>ITab_Pawn_Log</li>
    </inspectorTabs>
    <comps>
      <!-- Battery tunables (agent defaults, 2026-10-19): 10% lasts 150 cells; a conduit fills an empty dog in 2500
           ticks (1 h), the stable three times as fast, so from 10% a conduit wins when the stable is about 120 cells
           further away; a full charge from a conduit takes 100 Wd from its batteries. -->
      <li Class="Quadrunner.CompProperties_Robodog">
        <drainPerCell>0.000667</drainPerCell>
        <seekChargeAt>0.1</seekChargeAt>
        <conduitChargePerTick>0.0004</conduitChargePerTick>
        <stableChargePerTick>0.0012</stableChargePerTick>
        <energyPerFullCharge>100</energyPerFullCharge>
        <!-- Field fixes (agent defaults, 2026-10-20): a powered-down dog with a robodog battery in stock is left to
             the colonists for an hour before a dog carries it home; a repair kit goes to a dog below 70% health. -->
        <fieldFixWaitTicks>2500</fieldFixWaitTicks>
        <fieldRepairBelow>0.7</fieldRepairBelow>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="QR_RobodogBase">
    <defName>QR_Quadrunner</defName>
    <label>Quadrunner</label>
    <description>A four-legged utility robot. It docks at a stable, which sends it out to haul, clean and supply construction, and repairs and recharges it between jobs. A colonist can ride it: right-click it, or its stable, and pick a destination.</description>
    <modExtensions>
      <!-- Vanilla work givers, in priority order; jobs other than the listed ones are refused (a blocked blueprint
           would otherwise ask for plant cutting). Map-wide ones ignore the stable's service radius. -->
      <li Class="Quadrunner.RobodogWork">
        <workGivers>
          <li>DeliverResourcesToFrames</li>
          <li>DeliverResourcesToBlueprints</li>
          <li>HaulGeneral</li>
          <li>CleanFilth</li>
        </workGivers>
        <mapWide>
          <li>DeliverResourcesToFrames</li>
          <li>DeliverResourcesToBlueprints</li>
        </mapWide>
        <jobs>
          <li>HaulToCell</li>
          <li>HaulToContainer</li>
          <li>Clean</li>
        </jobs>
        <raidSpeedFactor>3</raidSpeedFactor>
        <raidDrainFactor>2</raidDrainFactor>
      </li>
      <!-- Riding (user, 2026-10-20): the rider moves at 7 cells/s (a colonist walks 4.6); the rider's draw offset from
           the dog per facing, x right and z up the screen, tuned with the "Quadrunner riding" tweak values. -->
      <li Class="Quadrunner.Rideable">
        <riddenMoveSpeed>7</riddenMoveSpeed>
        <offsetNorth>(0, 0, 0.42)</offsetNorth>
        <offsetEast>(-0.08, 0, 0.36)</offsetEast>
        <offsetSouth>(0, 0, 0.45)</offsetSouth>
        <offsetWest>(0.08, 0, 0.36)</offsetWest>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="QR_RobodogBase">
    <defName>QR_Medirunner</defName>
    <label>Medirunner</label>
    <description>A four-legged rescue robot. It docks at a stable, which sends it out whenever someone is down, raid or not, to carry them to a bed: colonists first, then guests, prisoners and colony animals, the fastest-bleeding first. It does no other work.</description>
    <modExtensions>
      <!-- Medic only (user, 2026-10-20): rescues, map-wide and under fire, nothing else; no raid speed or drain change. -->
      <li Class="Quadrunner.RobodogWork">
        <rescue>true</rescue>
        <raidSpeedFactor>1</raidSpeedFactor>
        <raidDrainFactor>1</raidDrainFactor>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Combatdogs: four tiers, each its own model (design). Every one is built at Tier 1 and upgraded from the stable's
       Overview tab; CombatTier names the next tier, its upgrade bill and what can fill each weapon slot. -->
  <ThingDef ParentName="QR_RobodogBase" Name="QR_CombatdogBase" Abstract="True">
    <label>Combatdog</label>
    <!-- Claws, cut and scratch (design); about a warg's claws. -->
    <tools Inherit="False">
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Cut</li>
          <li>Scratch</li>
        </capacities>
        <power>13</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Cut</li>
          <li>Scratch</li>
        </capacities>
        <power>13</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <!-- Like vanilla mechanoids: the intelligence that lets later tiers hold their built-in guns (design). -->
      <intelligence>ToolUser</intelligence>
    </race>
    <modExtensions>
      <!-- Combat only (user, 2026-10-20): no other work, no raid speed or drain change; 200% move speed while deployed
           (design); hostiles it sees within 15 cells join its stable's target queue (user, 2026-10-20). -->
      <li Class="Quadrunner.RobodogWork">
        <combat>true</combat>
        <raidSpeedFactor>1</raidSpeedFactor>
        <raidDrainFactor>1</raidDrainFactor>
        <deployedSpeedFactor>2</deployedSpeedFactor>
        <engageRange>15</engageRange>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="QR_CombatdogBase">
    <defName>QR_Combatdog</defName>
    <description>A four-legged guard robot with built-in claws (Tier 1). It docks at a stable and deploys when a raid starts, when a robodog is attacked anywhere on the map, or on order; deployed, it runs at double speed, attacks the nearest hostile it was sent after or sees nearby, and carries the downed to a prisoner bed. It does no other work.</description>
    <statBases>
      <MarketValue>900</MarketValue>
    </statBases>
    <modExtensions>
      <li Class="Quadrunner.CombatTier">
        <tier>1</tier>
        <next>QR_CombatdogTwo</next>
        <upgrade>QR_UpgradeCombatdogTwo</upgrade>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Durability per tier (design: much more durable, much more armor, extreme armor; agent default, 2026-10-20). -->
  <ThingDef ParentName="QR_CombatdogBase">
    <defName>QR_CombatdogTwo</defName>
    <description>A four-legged guard robot (Tier 2): much more durable than Tier 1, with a built-in gun as well as its claws. It docks at a stable and deploys when a raid starts, when a robodog is attacked anywhere on the map, or on order; deployed, it runs at double speed, attacks the nearest hostile it was sent after or sees nearby, and carries the downed to a prisoner bed. It does no other work.</description>
    <statBases>
      <MarketValue>1500</MarketValue>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
    </statBases>
    <race>
      <baseHealthScale>2</baseHealthScale>
    </race>
    <modExtensions>
      <li Class="Quadrunner.CombatTier">
        <tier>2</tier>
        <next>QR_CombatdogThree</next>
        <upgrade>QR_UpgradeCombatdogThree</upgrade>
        <slot1>
          <li>QR_Gun_AssaultRifle</li>
          <li>QR_Gun_LMG</li>
        </slot1>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="QR_CombatdogBase">
    <defName>QR_CombatdogThree</defName>
    <description>A four-legged guard robot (Tier 3): heavily armored, with two weapon slots: a gun, and a flamethrower it switches to at close range. It docks at a stable and deploys when a raid starts, when a robodog is attacked anywhere on the map, or on order; deployed, it runs at double speed, attacks the nearest hostile it was sent after or sees nearby, and carries the downed to a prisoner bed. It does no other work.</description>
    <statBases>
      <MarketValue>2400</MarketValue>
      <ArmorRating_Sharp>0.7</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
    </statBases>
    <race>
      <baseHealthScale>2</baseHealthScale>
    </race>
    <modExtensions>
      <li Class="Quadrunner.CombatTier">
        <tier>3</tier>
        <next>QR_CombatdogFour</next>
        <upgrade>QR_UpgradeCombatdogFour</upgrade>
        <slot1>
          <li>QR_Gun_AssaultRifle</li>
          <li>QR_Gun_LMG</li>
        </slot1>
        <slot2>
          <li>QR_Gun_Flamethrower</li>
        </slot2>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="QR_CombatdogBase">
    <defName>QR_CombatdogFour</defName>
    <description>A four-legged guard robot (Tier 4): extremely armored, with a built-in minigun that slows it a little. It docks at a stable and deploys when a raid starts, when a robodog is attacked anywhere on the map, or on order; deployed, it runs at double speed, attacks the nearest hostile it was sent after or sees nearby, and carries the downed to a prisoner bed. It does no other work.</description>
    <statBases>
      <MarketValue>3600</MarketValue>
      <ArmorRating_Sharp>1.0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
    </statBases>
    <race>
      <baseHealthScale>2.5</baseHealthScale>
    </race>
    <modExtensions>
      <li Class="Quadrunner.CombatTier">
        <tier>4</tier>
        <slot1>
          <li>QR_Gun_Minigun</li>
          <li>QR_Gun_AssaultRifle</li>
          <li>QR_Gun_LMG</li>
        </slot1>
      </li>
    </modExtensions>
  </ThingDef>

