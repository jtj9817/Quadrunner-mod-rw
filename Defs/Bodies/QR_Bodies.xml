<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- A four-legged machine built from vanilla mechanoid body parts (no blood, no pain, no lungs). The front feet carry
       the paw groups that the Combatdog's claws attack with. -->
  <BodyDef>
    <defName>QR_Robodog</defName>
    <label>robodog</label>
    <corePart>
      <def>MechanicalThorax</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <parts>
        <li>
          <def>Reactor</def>
          <coverage>0.06</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>FluidReprocessor</def>
          <coverage>0.06</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>MechanicalNeck</def>
          <coverage>0.18</coverage>
          <height>Top</height>
          <parts>
            <li>
              <def>MechanicalHead</def>
              <coverage>0.7</coverage>
              <groups>
                <li>HeadAttackTool</li>
              </groups>
              <parts>
                <li>
                  <def>ArtificialBrain</def>
                  <coverage>0.1</coverage>
                  <depth>Inside</depth>
                </li>
                <li>
                  <def>SightSensor</def>
                  <customLabel>left sight sensor</customLabel>
                  <coverage>0.1</coverage>
                </li>
                <li>
                  <def>SightSensor</def>
                  <customLabel>right sight sensor</customLabel>
                  <coverage>0.1</coverage>
                </li>
                <li>
                  <def>HearingSensor</def>
                  <customLabel>left hearing sensor</customLabel>
                  <coverage>0.08</coverage>
                </li>
                <li>
                  <def>HearingSensor</def>
                  <customLabel>right hearing sensor</customLabel>
                  <coverage>0.08</coverage>
                </li>
                <li>
                  <def>SmellSensor</def>
                  <coverage>0.08</coverage>
                </li>
                <li>
                  <def>QR_GripperJaw</def>
                  <coverage>0.08</coverage>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>MechanicalLeg</def>
          <customLabel>front left leg</customLabel>
          <coverage>0.07</coverage>
          <height>Bottom</height>
          <parts>
            <li><def>MechanicalFoot</def><customLabel>front left foot</customLabel><coverage>0.25</coverage><groups><li>FrontLeftPaw</li></groups></li>
          </parts>
        </li>
        <li>
          <def>MechanicalLeg</def>
          <customLabel>front right leg</customLabel>
          <coverage>0.07</coverage>
          <height>Bottom</height>
          <parts>
            <li><def>MechanicalFoot</def><customLabel>front right foot</customLabel><coverage>0.25</coverage><groups><li>FrontRightPaw</li></groups></li>
          </parts>
        </li>
        <li>
          <def>MechanicalLeg</def>
          <customLabel>rear left leg</customLabel>
          <coverage>0.07</coverage>
          <height>Bottom</height>
          <parts>
            <li><def>MechanicalFoot</def><customLabel>rear left foot</customLabel><coverage>0.25</coverage></li>
          </parts>
        </li>
        <li>
          <def>MechanicalLeg</def>
          <customLabel>rear right leg</customLabel>
          <coverage>0.07</coverage>
          <height>Bottom</height>
          <parts>
            <li><def>MechanicalFoot</def><customLabel>rear right foot</customLabel><coverage>0.25</coverage></li>
          </parts>
        </li>
      </parts>
    </corePart>
  </BodyDef>

  <!-- The dog's only manipulator: vanilla hauling needs the Manipulation capacity. -->
  <BodyPartDef>
    <defName>QR_GripperJaw</defName>
    <label>gripper jaw</label>
    <hitPoints>20</hitPoints>
    <permanentInjuryChanceFactor>0</permanentInjuryChanceFactor>
    <skinCovered>false</skinCovered>
    <solid>true</solid>
    <alive>false</alive>
    <bleedRate>0</bleedRate>
    <tags>
      <li>ManipulationLimbCore</li>
    </tags>
  </BodyPartDef>

</Defs>
