<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- During a raid, working robodogs finish their task faster (RobodogWork.raidSpeedFactor). -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/StatDef[defName="MoveSpeed"]/parts</xpath>
    <value>
      <li Class="Quadrunner.StatPart_RobodogRaid" />
    </value>
  </Operation>

  <!-- A mounted rider moves at the dog's ridden speed (Rideable.riddenMoveSpeed); last, so it sets the final value. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/StatDef[defName="MoveSpeed"]/parts</xpath>
    <value>
      <li Class="Quadrunner.StatPart_Riding" />
    </value>
  </Operation>

</Patch>
