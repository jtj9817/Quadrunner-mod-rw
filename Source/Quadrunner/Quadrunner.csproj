<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Quadrunner</RootNamespace>
    <AssemblyName>Quadrunner</AssemblyName>
    <Version>0.1.0</Version>
    <DebugType>embedded</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- tools/build.sh passes SourceRevisionId; don't let the SDK query git (root-owned mount). -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- Output stays in bin/; tools/build.sh installs it into 1.6/Assemblies with an atomic rename. -->
    <OutputPath>bin/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only game assemblies (Copy Local off): matches game 1.6.4871. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />
    <!-- Compile-only: the Harmony mod (brrainz.harmony, a dependency in About.xml) ships 0Harmony.dll 2.4.3 at runtime. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
